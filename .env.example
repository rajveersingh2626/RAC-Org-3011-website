# District 3011 Environment Configuration Template
# Copy this file to .env.local and populate with your credentials
# 
# SECURITY NOTE:
# - VITE_ prefixed variables are exposed in the browser JS bundle.
#   Only add VITE_ to variables that are SAFE to be publicly visible.
# - Never add API keys or secrets with the VITE_ prefix.

# Supabase (anon/public key — safe to expose, RLS protects your data)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Resend API Key — SERVER-SIDE ONLY (Vercel serverless function)
# This must NOT have the VITE_ prefix — it must never reach the browser.
RESEND_API_KEY=re_your_resend_api_key_here
